### Project Documents API Smoke Tests
### Run against local development environment
### Requires seeded admin user (testadmin / TestAdmin123!) and nonmember (nonmember / NonMember123!)

@baseUrl = http://localhost:5000

# ── Auth ────────────────────────────────────────────────────

# @name loginAdmin

POST {{baseUrl}}/api/auth/login HTTP/1.1
Content-Type: application/json
X-Correlation-Id: smoke-pd-001

{
  "password": "TestAdmin123!",
  "username": "testadmin"
}


###

@adminToken = {{loginAdmin.response.body.$.accessToken}}

# ── Project Setup ───────────────────────────────────────────

# @name createProject

POST {{baseUrl}}/api/projects HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-002

{
  "description": "Project for project-document smoke test",
  "gitProvider": "github",
  "gitRemoteUrl": "https://github.com/test/project-documents.git",
  "name": "Project Document Smoke Test Project"
}


###

# ═══════════════════════════════════════════════════════════
# PROJECT DOCUMENT ENDPOINTS
# ═══════════════════════════════════════════════════════════

# ── Create Document (Scope) ─────────────────────────────────
# POST /api/projects/{projectId}/ProjectDocuments

# @name createScopeDoc

POST {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-003

{
  "docType": "Scope",
  "title": "Project Scope",
  "description": "What this project covers",
  "content": "# Scope\n\nInitial scope document."
}


###

# ── List Documents ──────────────────────────────────────────
# GET /api/projects/{projectId}/ProjectDocuments

GET {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments HTTP/1.1
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-004


###

# ── Get Document by ID ───────────────────────────────────────
# GET /api/projects/{projectId}/ProjectDocuments/{documentId}

GET {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/{{createScopeDoc.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-005


###

# ── Update Document ──────────────────────────────────────────
# PUT /api/projects/{projectId}/ProjectDocuments/{documentId}

# @name updateScopeDoc

PUT {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/{{createScopeDoc.response.body.$.id}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-006

{
  "title": "Project Scope Updated",
  "description": "What this project covers, revised",
  "content": "# Scope\n\nUpdated scope document."
}


###

# ── Verify Updated Document ──────────────────────────────────

GET {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/{{createScopeDoc.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-007


###

# ── List Document Versions ───────────────────────────────────
# GET /api/projects/{projectId}/ProjectDocuments/{documentId}/versions

GET {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/{{createScopeDoc.response.body.$.id}}/versions HTTP/1.1
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-008


###

# ── Restore Document to v1 ────────────────────────────────────
# POST /api/projects/{projectId}/ProjectDocuments/{documentId}/restore

POST {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/{{createScopeDoc.response.body.$.id}}/restore HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-009

{
  "version": 1
}


###

# ── Verify Restored Document ─────────────────────────────────
# Content should be back to v1, version bumped to 3

GET {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/{{createScopeDoc.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-010


###

# ═══════════════════════════════════════════════════════════
# UNIQUENESS RULES
# ═══════════════════════════════════════════════════════════

# Second Scope document — expect 409 (Scope is single-doc-per-project)

POST {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-011

{
  "docType": "Scope",
  "title": "Duplicate Scope",
  "description": null,
  "content": "# Should fail"
}


###

# First Reference document — expect 201 (Reference allows N)

# @name createReferenceDoc1

POST {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-012

{
  "docType": "Reference",
  "title": "Reference Doc 1",
  "description": null,
  "content": "# Reference 1"
}


###

# Second Reference document — expect 201 (Reference allows N)

POST {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-013

{
  "docType": "Reference",
  "title": "Reference Doc 2",
  "description": null,
  "content": "# Reference 2"
}


###

# ═══════════════════════════════════════════════════════════
# ERROR CASES
# ═══════════════════════════════════════════════════════════

# Non-member access — expect 403

# @name loginNonMember

POST {{baseUrl}}/api/auth/login HTTP/1.1
Content-Type: application/json
X-Correlation-Id: smoke-pd-014

{
  "password": "NonMember123!",
  "username": "nonmember"
}


###

# Non-member tries to list documents — expect 403

GET {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments HTTP/1.1
Authorization: Bearer {{loginNonMember.response.body.$.accessToken}}
X-Correlation-Id: smoke-pd-015


###

# Get non-existent document — expect 404

GET {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/00000000-0000-0000-0000-000000000000 HTTP/1.1
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-016


###

# Update non-existent document — expect 404

PUT {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/00000000-0000-0000-0000-000000000000 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-017

{
  "title": "Nope",
  "description": null,
  "content": "# Won't work"
}


###

# Restore non-existent document version — expect 404

POST {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/ProjectDocuments/{{createScopeDoc.response.body.$.id}}/restore HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-018

{
  "version": 999
}


###

# ── Cleanup ─────────────────────────────────────────────────

POST {{baseUrl}}/api/projects/{{createProject.response.body.$.id}}/toggle-archive HTTP/1.1
Authorization: Bearer {{adminToken}}
X-Correlation-Id: smoke-pd-019
