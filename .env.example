POSTGRES_DB=hydraforge
POSTGRES_USER=hydraforge
POSTGRES_PASSWORD=change-this-postgres-password
# Host-side port — mapped to container 5432. Using 5433 to avoid conflict with any
# local PostgreSQL or Odysseus (which runs on the same machine).
POSTGRES_PORT=5433

# Production disables the Scalar API reference UI, the OpenAPI JSON endpoint, and
# the Development-only test user seeder (testadmin/testuser1/nonmember — real
# security relevance, not just clutter: those are fixed, publicly-known credentials).
# Set to Development only for local work against this repo's own source
# (`dotnet run`/`pnpm dev`, or a Docker box you're actively developing against and
# want the test accounts on).
ASPNETCORE_ENVIRONMENT=Production
# Container-internal port — always 8080 regardless of SERVER_PORT below (that's
# only the host-side mapping, see docker-compose.yml).
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Default=Host=localhost;Port=5433;Database=hydraforge;Username=hydraforge;Password=change-this-postgres-password

# ─── Docker Compose host port overrides ────────────────────────────────────────
# Every port docker-compose.yml binds on the host is configurable here — change
# whichever one collides with something already running on your machine/NAS.
# Defaults match the comments next to each service in docker-compose.yml.
# SERVER_PORT=5000
# WEB_PORT=3000
# HTTP_PORT=8080
# HTTPS_PORT=8443
# SEARXNG_PORT=8082
# NTFY_PORT=8083

# File storage (Local or S3)
FILE_STORAGE_PROVIDER=Local
FileStorage__Provider=Local
# Host-side local storage path. Docker Compose overrides this to
# /data/hydraforge/attachments and mounts a named volume there.
FileStorage__LocalPath=.hydraforge/attachments
FileStorage__MaxBytes=10485760
# S3-compatible (MinIO or AWS S3 — when FileStorage__Provider=S3):
# FileStorage__S3__BucketName=hydraforge-attachments
# FileStorage__S3__Region=us-east-1
# FileStorage__S3__AccessKey=minioadmin
# FileStorage__S3__SecretKey=minioadmin
# FileStorage__S3__Endpoint=http://localhost:9000
# FileStorage__S3__ForcePathStyle=true

# MinIO-specific (for docker compose — default creds, override via .env):
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hydraforge-attachments
MINIO_REGION=us-east-1

Jwt__Issuer=HydraForge
Jwt__Audience=HydraForge
Jwt__SigningKey=change-this-to-at-least-32-random-characters
Jwt__AccessTokenMinutes=60

AdminSeed__Username=admin
AdminSeed__Password=change-this-admin-password

Argon2__MemorySizeKiB=65536
Argon2__Iterations=3
Argon2__Parallelism=4

# ─── LLM ──────────────────────────────────────────────────────────────────────
# base64-encoded 32-byte AES-256 key — required at startup, server crashes without it
# (AddLlmInfrastructure validates it before the app boots). Generate your own with:
#   openssl rand -base64 32
Llm__EncryptionKey=ckaOH71rTlfT6cR0r28AObevMLQSJFCz4goqiV2aMwY=
# Fraction of a model's context window that triggers ContextCompressor auto-summarization.
Llm__ContextCompressionThresholdRatio=0.75

Logging__MinimumLevel=Information
# Reuse Odysseus's SearXNG running on the host (127.0.0.1:8080).
# host.docker.internal resolves to the Docker host from inside a container.
# If running without Docker (dotnet run), change to http://localhost:8080.
# If running your own SearXNG via --profile search, change to http://searxng:8080.
SearXng__BaseUrl=http://host.docker.internal:8080

# ─── Notifications (ntfy) ─────────────────────────────────────────────────────
# Start with: docker compose --profile notifications up
NTFY_BASE_URL=http://localhost:8083

# ─── Web UI ───────────────────────────────────────────────────────────────────
# Private — Nuxt server-side proxy target for /api/... and SSR API calls.
# Docker Compose overrides this to http://server:8080 per docker-compose.yml.
NUXT_API_BASE_URL=http://localhost:5000

# SignalR hub base URL.
# Leave empty (default) in Docker — nginx routes /hubs/ directly to .NET with WS support.
# Set to http://localhost:5000 for local dev (dotnet run + pnpm dev) to enable
# direct WebSocket connection, eliminating WS errors in the browser console.
# NUXT_PUBLIC_SIGNALR_BASE_URL=http://localhost:5000

# CORS: comma-separated allowed origins for the .NET backend.
# Docker default (nginx port 80): http://localhost
# For Tailscale or a real domain, add your host: http://100.x.x.x,https://app.example.com
# Ran deploy/tailscale-https-setup.sh? Use the https://...:8443 origin it printed, and
# also set NUXT_PUBLIC_AUTH_COOKIE_SECURE=true below — the two must move together, a
# Secure cookie is silently dropped by the browser if CORS still points at plain http.
# CORS_ALLOWED_ORIGINS=http://localhost

# Trusted reverse-proxy network(s) for X-Forwarded-For/X-Forwarded-Proto (CIDR,
# comma-separated). Set this whenever running behind this repo's own nginx service
# (the default full-Docker-stack path) or any other reverse proxy — without it, the
# forwarded-headers middleware only trusts loopback, so: rate limiting and audit logs
# see the proxy's IP for every request instead of the real client's, AND the server
# can never tell an HTTPS-via-nginx request from plain HTTP, so Strict-Transport-Security
# never gets added even once HTTPS is set up. Docker Compose's default bridge network is
# commonly within 172.16.0.0/12, but run `docker network inspect <project>_default` to
# confirm your actual subnet rather than assuming.
ForwardedHeaders__KnownNetworks=172.16.0.0/12

# ─── TUI Configuration ──────────────────────────────────────────────────────────
# Server URL for the HydraForge API
# ServerUrl=http://localhost:5000

# Auth cookie settings
NUXT_PUBLIC_AUTH_COOKIE_MAX_AGE=3600
# Must be "true" once served over HTTPS (see deploy/tailscale-https-setup.sh) — a
# Secure cookie is silently dropped by the browser over plain HTTP, and leaving this
# false over HTTPS is an avoidable downgrade. Keep in lockstep with CORS_ALLOWED_ORIGINS
# above (both http, or both https — never mixed).
NUXT_PUBLIC_AUTH_COOKIE_SECURE=false
