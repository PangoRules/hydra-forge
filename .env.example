# ═════════════════════════════════════════════════════════════════════════════
# HydraForge environment configuration
# Copy to .env, fill in secrets, pick a run mode in the Web UI section below.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
# Production hides Scalar UI, OpenAPI JSON, and the test-user seeder.
# Use Development only for local work against this repo's source.
ASPNETCORE_ENVIRONMENT=Production
# Container-internal port — isolated inside the server container, never collides
# with host ports. Coupled to the healthcheck + nginx BACKEND_HOST default in
# docker-compose.yml, so leave at 8080. Host mapping is SERVER_PORT below.
ASPNETCORE_URLS=http://+:8080

# ─── Database (Postgres) ─────────────────────────────────────────────────────
POSTGRES_DB=hydraforge
POSTGRES_USER=hydraforge
POSTGRES_PASSWORD=change-this-postgres-password
# Host-side port → container 5432. 5433 avoids conflict with local postgres.
POSTGRES_PORT=5433
# Only used by host-side `dotnet run` (no Docker). In Docker, docker-compose.yml's
# `environment:` block overrides this (environment: > env_file:) with
# Host=postgres;Port=5432 — the internal network, since localhost inside the
# container is the container itself, not your host.
ConnectionStrings__Default=Host=localhost;Port=5433;Database=hydraforge;Username=hydraforge;Password=change-this-postgres-password

# ─── Auth ────────────────────────────────────────────────────────────────────
Jwt__Issuer=HydraForge
Jwt__Audience=HydraForge
# ≥32 random chars. Generate with: openssl rand -hex 32
Jwt__SigningKey=change-this-to-at-least-32-random-characters
Jwt__AccessTokenMinutes=60
# Admin user seeded on first boot.
AdminSeed__Username=admin
AdminSeed__Password=change-this-admin-password
# Argon2 password-hash params — tune if you need weaker/stronger hashing.
Argon2__MemorySizeKiB=65536
Argon2__Iterations=3
Argon2__Parallelism=4

# ─── File Storage ────────────────────────────────────────────────────────────
# Local or S3.
FILE_STORAGE_PROVIDER=Local
FileStorage__Provider=Local
# Host-side path. Docker Compose overrides to /data/hydraforge/attachments.
FileStorage__LocalPath=.hydraforge/attachments
FileStorage__MaxBytes=10485760
# S3 (MinIO or AWS S3) — uncomment when FileStorage__Provider=S3:
# FileStorage__S3__BucketName=hydraforge-attachments
# FileStorage__S3__Region=us-east-1
# FileStorage__S3__AccessKey=minioadmin
# FileStorage__S3__SecretKey=minioadmin
# FileStorage__S3__Endpoint=http://localhost:9000
# FileStorage__S3__ForcePathStyle=true

# ─── MinIO (Docker Compose only) ──────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hydraforge-attachments
MINIO_REGION=us-east-1

# ─── LLM ──────────────────────────────────────────────────────────────────────
# base64 32-byte AES-256 key for encrypting provider API keys at rest.
# Required at startup — server crashes without it. Generate: openssl rand -base64 32
Llm__EncryptionKey=ckaOH71rTlfT6cR0r28AObevMLQSJFCz4goqiV2aMwY=
# Fraction of model context window that triggers ContextCompressor auto-summarize.
Llm__ContextCompressionThresholdRatio=0.75

# ─── Web UI ───────────────────────────────────────────────────────────────────
# Pick the set matching your run mode — set all three together:
#   A) Full Docker, HTTP:        http://localhost:3000 | false | (unset)
#   B) Full Docker + Tailscale:  https://<host>:8443   | true  | (unset)
#   C) Hybrid (pnpm dev local):  http://localhost:3000 | false | http://localhost:5000
#   D) Pure local (dotnet run):  http://localhost:3000 | false | http://localhost:5000
# Why: CORS must match browser origin or preflight 204s silently. Secure cookie
#      drops over HTTP. SignalR base only needed when bypassing nginx (/hubs/).
# Restart server after change:  docker compose up -d --force-recreate server

# Nuxt server-side proxy target for /api/... and SSR. Docker overrides to server:8080.
NUXT_API_BASE_URL=http://localhost:5000
# Comma-separated allowed origins for the .NET backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secure cookie flag — true only when CORS is https://.
NUXT_PUBLIC_AUTH_COOKIE_SECURE=false
# Set only when browser can't reach /hubs/ via nginx (modes C/D). Else leave unset.
NUXT_PUBLIC_SIGNALR_BASE_URL=
# Auth cookie max age in seconds.
NUXT_PUBLIC_AUTH_COOKIE_MAX_AGE=3600

# ─── Reverse Proxy (nginx) ───────────────────────────────────────────────────
# Leave unset for full Docker stack — nginx uses docker-compose.yml defaults
# (server:8080, web:3000) over the internal Docker network. Set both only for
# hybrid mode (server/web running locally, not as containers):
# BACKEND_HOST=host.docker.internal:5000
# NUXT_HOST=host.docker.internal:3000
# Trusted reverse-proxy network(s) for X-Forwarded-For/X-Forwarded-Proto (CIDR).
# Without this: rate limiting/audit see nginx's IP, and HSTS never fires over HTTPS.
# Docker Compose default bridge is usually 172.16.0.0/12 — verify with
# `docker network inspect <project>_default` if unsure.
ForwardedHeaders__KnownNetworks=172.16.0.0/12

# ─── External Services ────────────────────────────────────────────────────────
# SearXNG search backend. Reuses Odysseus on the host by default.
#   dotnet run (no Docker):  http://localhost:8080
#   Own SearXNG via --profile search:  http://searxng:8080
SearXng__BaseUrl=http://host.docker.internal:8080
# ntfy notifications. Start with: docker compose --profile notifications up
NTFY_BASE_URL=http://localhost:8083

# ─── TUI ──────────────────────────────────────────────────────────────────────
# Server URL for the HydraForge API (terminal client).
# ServerUrl=http://localhost:5000

# ─── Docker Compose Port Overrides ────────────────────────────────────────────
# Host-side port mappings. Change whichever collides with something on your box.
# SERVER_PORT=5000
# WEB_PORT=3000
# HTTP_PORT=8080
# HTTPS_PORT=8443
# SEARXNG_PORT=8082
# NTFY_PORT=8083

# ─── Logging ──────────────────────────────────────────────────────────────────
Logging__MinimumLevel=Information
